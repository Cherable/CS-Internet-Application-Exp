DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
DJANGO_ALLOWED_HOSTS=shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
DJANGO_HTTPS=false
DB_ENGINE=mysql
MYSQL_DATABASE=orangible
MYSQL_USER=orangible
MYSQL_PASSWORD=REPLACE_APP_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_ROOT_PASSWORD
MYSQL_HOST=db
MYSQL_PORT=3306
DEMO_PAYMENT_ENABLED=true
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=orangible@example.invalid
NGINX_CONFIG=http.conf

# Optional SMS; production defaults to disabled. Demo is permitted only with DEBUG=true.
SMS_BACKEND=disabled
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ENABLE_ALIYUN_SMS=false
