# Copy to .env. Local preview only; never commit real secrets.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=local-development-only-change-before-deployment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DB_ENGINE=sqlite
# Production: DB_ENGINE=mysql, DJANGO_DEBUG=false and a random secret key.
MYSQL_DATABASE=campus_shop
MYSQL_USER=campus_shop
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Explicitly labelled simulation. No real funds or platform callback.
DEMO_PAYMENT_ENABLED=true
# Console output is a preview, not delivery. For SMTP change backend + credentials locally.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=orangible@example.invalid
